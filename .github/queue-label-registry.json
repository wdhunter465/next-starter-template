  "rules": [
    {
      "id": "single-team-owner",
      "selector": "team:*",
      "cardinality": "zero-or-one",
      "failure": "incomplete-or-routing-ineligible"
    },
    {
      "id": "operations-state",
      "when": [
        "team:operations"
      ],
      "requiresExactlyOneOf": [
        "ops:priority:1",
        "ops:priority:2",
        "ops:priority:3",
        "ops:priority:4",
        "ops:monitoring",
        "ops:hold"
      ],
      "forbidsPrefixes": [
        "pmo:priority:",
        "pmo:pipeline-priority:",
        "eng:priority:",
        "gov:",
        "pmo:stage:"
      ]
    },
    {
      "id": "governance-state",
      "when": [
        "team:governance"
      ],
      "requiresExactlyOneOf": [
        "gov:priority:1",
        "gov:priority:2",
        "gov:priority:3",
        "gov:priority:4",
        "gov:review",
        "gov:hold"
      ],
      "forbidsPrefixes": [
        "ops:",
        "pmo:priority:",
        "pmo:pipeline-priority:",
        "eng:priority:",
        "pmo:stage:"
      ]
    },
    {
      "id": "active-parent",
      "when": [
        "pmo",
        "pmo:active",
        "portfolio-parent"
      ],
      "requires": [
        "team:pmo"
      ],
      "requiresExactlyOneMatching": "^pmo:priority:[1-9]\\d*$",
      "forbidsPrefixes": [
        "eng:priority:",
        "pmo:pipeline-priority:",
        "ops:",
        "gov:"
      ],
      "forbids": [
        "pmo:stage:initial-idea",
        "pmo:stage:drafted-design",
        "pmo:stage:pending-launch-packet",
        "pmo:stage:graduation-candidate",
        "pmo:stage:intake",
        "pmo:stage:discovery",
        "pmo:stage:definition",
        "pmo:stage:planning",
        "pmo:stage:prep",
        "pmo:stage:ready-for-launch"
      ]
    },
    {
      "id": "pipeline-parent",
      "when": [
        "pmo",
        "pmo:pipeline",
        "portfolio-parent"
      ],
      "requires": [
        "team:pmo"
      ],
      "requiresExactlyOneMatching": "^pmo:pipeline-priority:[1-9]\\d*$",
      "requiresExactlyOneOf": [
        "pmo:stage:initial-idea",
        "pmo:stage:drafted-design",
        "pmo:stage:pending-launch-packet",
        "pmo:stage:graduation-candidate"
      ],
      "forbidsPrefixes": [
        "pmo:priority:",
        "eng:priority:",
        "ops:",
        "gov:"
      ]
    },
    {
      "id": "project-child",
      "when": [
        "pmo:task"
      ],
      "requiresExactlyOneOf": [
        "pmo:pipeline",
        "pmo:active",
        "pmo:closed"
      ],
      "requiresBodyReference": "Parent Project: #<number> or equivalent approved parent field",
      "forbidsPrefixes": [
        "team:",
        "ops:",
        "gov:",
        "pmo:priority:",
        "pmo:pipeline-priority:",
        "eng:priority:"
      ]
    },
    {
      "id": "project-graduation",
      "transition": "pipeline-to-active",
      "remove": [
        "pmo:pipeline",
        "pmo:pipeline-priority:*",
        "pmo:stage:*"
      ],
      "add": [
        "pmo:active",
        "team:pmo",
        "one PMO-selected pmo:priority:<n> Active ordered position"
      ],
      "automaticPriorityTransfer": false
    }
  ],
  "legacyTreatment": {
    "preserveWithoutQueueAuthority": [
      "orchestrator",
      "status:queued",
      "status:blocked",
      "status:assigned",
      "status:pr-draft",
      "status:implementation",
      "status:review",
      "status:merged",
      "status:post-merge-verify",
      "status:complete",
      "status:failed",
      "type:repository",
      "type:website",
      "type:governance",
      "type:docs",
      "type:recovery",
      "type:ci",
      "agent:ChatGPT",
      "agent:cursor",
      "agent:codex"
    ],
    "quarantineForExplicitRetirementOrRemappingDecision": [
      "agent:copilot"
    ],
    "replaceOnlyAfterIssueSpecificValidation": [
      {
        "from": "pmo:priority:idea",
        "to": "eng:priority:idea",
        "appliesWhen": "pre-Pipeline Engineering qualification Issue",
        "otherwise": "quarantine"
      },
      {
        "from": "pmo:stage:intake",
        "to": "pmo:stage:initial-idea",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent after Engineering qualification"
      },
      {
        "from": "pmo:stage:discovery",
        "to": "pmo:stage:drafted-design",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent"
      },
      {
        "from": "pmo:stage:definition",
        "to": "pmo:stage:drafted-design",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent"
      },
      {
        "from": "pmo:stage:planning",
        "to": "pmo:stage:pending-launch-packet",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent"
      },
      {
        "from": "pmo:stage:prep",
        "to": "pmo:stage:pending-launch-packet",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent"
      },
      {
        "from": "pmo:stage:ready-for-launch",
        "to": "pmo:stage:graduation-candidate",
        "appliesWhen": "PMO-tracked Pipeline portfolio parent"
      }
    ],
    "removeFromProjectChildren": [
      "team:*",
      "ops:*",
      "gov:*",
      "pmo:priority:*",
      "pmo:pipeline-priority:*",
      "eng:priority:*"
    ],
    "prohibited": [
      "pmo:priority:none",
      "multiple team:* labels",
      "cross-namespace priority combinations"
    ]
  },
  "migrationStages": [
    "capture-complete-pre-migration-snapshot",
    "create-missing-target-labels-without-applying-them",
    "validate-registry-and-no-name-collisions",
    "migrate-unambiguous-operations-source-issues",
    "migrate-unambiguous-active-portfolio-parents",
    "migrate-unambiguous-pipeline-portfolio-parents",
    "remove-team-and-team-priority-labels-from-valid-project-children",
    "quarantine-ambiguous-or-authority-incomplete-issues",
    "regenerate-and-validate-dashboard",
    "verify-routing-dispatch-and-scheduled-runs",
    "retire-zero-use-legacy-labels-only-by-separate-recorded-decision"
  ]
}
