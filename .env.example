# LGFC-Lite Environment Variables (template)
# Copy to .env for local dev only. Do NOT commit .env.
#
# Cloudflare Pages (production) uses project/env settings and GitHub secrets.

# Public site URL (prod). Used for links and for Next.js local proxy fallbacks.
NEXT_PUBLIC_SITE_URL=https://next-starter-template-6yr.pages.dev

# Google Analytics 4 measurement ID (optional). When unset, no GA scripts are loaded.
# Set in Cloudflare Pages → Settings → Environment variables for production builds.
NEXT_PUBLIC_GA_ID=

# Optional: when running `npm run dev`, the Next.js API routes can proxy to the deployed Pages Functions
# (because Pages Functions don't run inside `next dev`).
PAGES_SITE_URL=https://next-starter-template-6yr.pages.dev

# --- Email (Phase 6) ---
# Email sending is optional. If not configured, join requests still store in D1 and return ok.
# Cloudflare Workers/Pages can send email via MailChannels HTTP API.
MAILCHANNELS_ENABLED=0
MAILCHANNELS_API_KEY=change-me-mailchannels-api-key
MAIL_FROM=Lou Gehrig Fan Club <noreply@lougehrigfanclub.com>
MAIL_REPLY_TO=admin@lougehrigfanclub.com
MAIL_ADMIN_TO=admin@lougehrigfanclub.com

# Admin Emails (comma-separated list for admin role access)
ADMIN_EMAILS=billhunter71@gmail.com

# If you want to use a custom send provider later, keep these placeholders (not used today):
# RESEND_API_KEY=
# SENDGRID_API_KEY=


# --- Backblaze B2 (S3-compatible) ---
# Source of image files. Secrets should live in GitHub/Cloudflare, not in committed files.
B2_KEY_ID=
B2_APP_KEY=
B2_ENDPOINT=   # e.g. https://s3.us-west-004.backblazeb2.com
B2_BUCKET=
PUBLIC_B2_BASE_URL=  # Public base URL for images (often Cloudflare CDN in front of B2)

# --- Cloudflare D1 ---
# D1 database name for LGFC-Lite (default: lgfc_lite)
D1_DB_NAME=lgfc_lite
CLOUDFLARE_API_TOKEN=  # API token with D1 edit permissions
CLOUDFLARE_ACCOUNT_ID=  # Cloudflare account ID
