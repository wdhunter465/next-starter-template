{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/lgfc-session-start-bind.sh",
        "timeout": 25
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/lgfc-session-end-release.sh",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "./hooks/lgfc-stop-continuous-pass.sh",
        "timeout": 15,
        "loop_limit": 3
      }
    ]
  }
}
