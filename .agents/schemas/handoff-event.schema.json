{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lgfc-handoff-event",
  "title": "LGFC structured handoff event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "event", "subject"],
  "properties": {
    "schema": { "const": "handoff-event" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "event": {
      "enum": [
        "PROBLEM FOUND",
        "GUIDANCE",
        "ADJUSTMENT",
        "HOLD",
        "PLAN CHANGE REQUIRED",
        "RESUME",
        "IMPLEMENTATION HANDOFF",
        "PR REVIEW REQUEST",
        "APPROVED FOR INTEGRATION",
        "CLOSEOUT",
        "RISK IDENTIFIED"
      ]
    },
    "subject": { "type": "string", "minLength": 1 },
    "sourceRole": { "type": "string" },
    "evidence": { "type": "string" }
  }
}
