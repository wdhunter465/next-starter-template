{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lgfc-assignment-envelope",
  "title": "LGFC assignment envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "product",
    "sourceIssue",
    "branch",
    "mode",
    "promotionProfile",
    "allowlist",
    "implementer",
    "reviewer",
    "implementationGo",
    "protectedStops"
  ],
  "properties": {
    "schema": { "const": "assignment-envelope" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "product": { "type": "string", "minLength": 1 },
    "sourceIssue": { "type": "integer", "minimum": 1 },
    "parent": { "type": "integer", "minimum": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "startingShaRequired": { "type": "boolean" },
    "mode": { "type": "string", "minLength": 1 },
    "promotionProfile": { "type": "string", "minLength": 1 },
    "allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "implementer": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "implementationGo": { "enum": ["recorded", "required-on-source-issue", "missing"] },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protectedStops": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
