{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lgfc-agent-product-config",
  "title": "LGFC agent product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "product",
    "status",
    "durableRole",
    "roleMappingAuthority",
    "authorityChain",
    "pilotIsolation",
    "cannotGrant"
  ],
  "properties": {
    "schema": { "const": "agent-product-config" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "product": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pilot", "active", "retired"] },
    "durableRole": { "type": "string", "minLength": 1 },
    "roleMappingAuthority": { "type": "string", "minLength": 1 },
    "authorityChain": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "pilotIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routedProducts", "excludedProducts"],
      "properties": {
        "routedProducts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "excludedProducts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "cannotGrant": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["merge", "production", "standing-role", "self-approval"] }
    },
    "mergeAuthority": { "not": {} },
    "productionGo": { "not": {} }
  }
}
