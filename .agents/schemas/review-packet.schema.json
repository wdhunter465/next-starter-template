{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lgfc-review-packet",
  "title": "LGFC engineering review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "sourceIssue", "reviewer", "selfApprovalProhibited"],
  "properties": {
    "schema": { "const": "review-packet" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "sourceIssue": { "type": "integer", "minimum": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "selfApprovalProhibited": { "const": true }
  }
}
