{
  "schemaVersion": 1,
  "repository": "wdhunter465/next-starter-template",
  "scope": "repository",
  "runner": {
    "name": "lgfc-codex-chromebook",
    "operatingSystem": "linux",
    "distribution": "debian-12",
    "architecture": "x64",
    "serviceManager": "systemd",
    "labels": [
      "self-hosted",
      "linux",
      "x64",
      "lgfc-codex"
    ]
  },
  "security": {
    "publicRepository": true,
    "trustedEvents": [
      "issues",
      "workflow_dispatch"
    ],
    "trustedRefs": [
      "refs/heads/main"
    ],
    "trustedActors": [
      "wdhunter465",
      "wdhunter645"
    ],
    "allowForkPullRequests": false,
    "allowPullRequestEvents": false,
    "allowPullRequestTargetEvents": false,
    "allowWorkflowRunEvents": false,
    "allowPushEvents": false,
    "allowScheduledEvents": false,
    "allowRepositorySecrets": false,
    "allowProductionCredentials": false,
    "allowDeployments": false,
    "allowPersistentGitCredentials": false,
    "executeIssueOrCommentContent": false,
    "mayCheckoutUntrustedRefs": false,
    "promptAuthority": "identifiers-only — Codex must fetch the source Issue after start"
  },
  "dispatch": {
    "enabled": true,
    "workflow": ".github/workflows/lgfc-codex-dispatch.yml",
    "wrapper": "scripts/lgfc-codex-dispatch/dispatch.mjs",
    "purpose": "Wake local Codex headlessly with repository/event identifiers only",
    "requiredLabels": [
      "agent:codex",
      "handoff:ready"
    ],
    "mayLaunchCodex": true,
    "mayHoldApiKeys": false,
    "mayClaimSerialLane": false,
    "prohibitYolo": true,
    "prohibitForce": true,
    "prohibitDangerousBypass": true,
    "packetAuthority": "none — Codex loads live Issue authority after start"
  },
  "observability": {
    "healthWorkflow": ".github/workflows/lgfc-codex-runner-health.yml",
    "healthRunsOn": "ubuntu-latest",
    "independentOfSelfHostedRunner": true
  },
  "rollout": {
    "state": "cursor-parity-first",
    "sourceIssue": "#4052",
    "relatedIssues": ["#3808", "#3212", "#3844"],
    "failedPredecessor": "#3844-not-operational"
  },
  "operations": {
    "workDirectory": "_work",
    "runnerApplicationAutoUpdate": true,
    "preserveStateOnStop": true,
    "requiredOutboundPort": 443,
    "hostMustBeDedicatedToRunnerWork": true,
    "hostMustNotContainPersonalOrProductionSecrets": true,
    "localLockPath": "~/.lgfc-codex-dispatch/dispatch.lock"
  }
}
